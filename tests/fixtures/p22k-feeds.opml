<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head><title>My reader</title></head>
  <body>
    <outline text="Tech" title="Tech">
      <outline type="rss" text="The Verge" title="The Verge" xmlUrl="https://www.theverge.com/rss/index.xml" htmlUrl="https://www.theverge.com"/>
      <outline type="rss" text="Ars Technica" xmlUrl="https://feeds.arstechnica.com/arstechnica/index"/>
      <outline type="rss" text="The Verge again" xmlUrl="https://www.theverge.com/rss/index.xml"/>
      <outline text="Nested">
        <outline type="rss" text="Hacker News" xmlUrl="https://hnrss.org/frontpage"/>
      </outline>
      <outline type="rss" text="Not a link" xmlUrl="javascript:alert(1)"/>
    </outline>
    <outline text="Cuisine">
      <outline type="rss" text="Délices" xmlUrl="https://delices.example.fr/feed/"/>
      <outline type="rss" text="مطبخ" xmlUrl="https://matbakh.example/rss.xml"/>
      <outline type="rss" text="Local" xmlUrl="ftp://files.example.com/feed.xml"/>
    </outline>
    <outline type="rss" text="Loose blog" xmlUrl="https://loose.example.org/atom.xml"/>
  </body>
</opml>
