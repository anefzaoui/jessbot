{"wireMagic":"pb3","pens":[{}],"wsWinStyles":[{}],"wpWinPositions":[{}],"events":[{"tStartMs":400,"dDurationMs":3587,"segs":[{"utf8":"A solar eclipse, one of\nthe year's best meteor showers."}]},{"tStartMs":4037,"dDurationMs":2085,"segs":[{"utf8":"Venus at its brightest\nin the evening"}]},{"tStartMs":6122,"dDurationMs":3320,"segs":[{"utf8":"sky, and a lunar eclipse\nto close out the month."}]},{"tStartMs":9509,"dDurationMs":2486,"segs":[{"utf8":"That's What's Up for August."}]},{"tStartMs":11995,"dDurationMs":4087,"segs":[{"utf8":"On August 12th, a total solar\neclipse crosses northern Russia,"}]},{"tStartMs":16116,"dDurationMs":2719,"segs":[{"utf8":"Greenland,\nIceland and northern Spain,"}]},{"tStartMs":18835,"dDurationMs":3437,"segs":[{"utf8":"with a small corner of Portugal\ninside the path of totality."}]},{"tStartMs":23156,"dDurationMs":4004,"segs":[{"utf8":"In parts of the United States\nfrom Alaska to North Carolina,"}]},{"tStartMs":27193,"dDurationMs":2119,"segs":[{"utf8":"the eclipse is partial."}]},{"tStartMs":29312,"dDurationMs":3170,"segs":[{"utf8":"The moon will only take\na small bite out of the sun,"}]},{"tStartMs":32482,"dDurationMs":3387,"segs":[{"utf8":"and the amount of coverage\nwill vary by location."}]},{"tStartMs":36152,"dDurationMs":2770,"segs":[{"utf8":"As with all solar events,\nremember to watch"}]},{"tStartMs":38922,"dDurationMs":3236,"segs":[{"utf8":"safely, never\nlooking directly at the sun."}]},{"tStartMs":42559,"dDurationMs":1401,"segs":[{"utf8":"Later that same night,"}]},{"tStartMs":43960,"dDurationMs":3003,"segs":[{"utf8":"the Perseid meteor\nshower will light up the sky."}]},{"tStartMs":46963,"dDurationMs":3504,"segs":[{"utf8":"It peaks the evening of August\n12th into the early morning"}]},{"tStartMs":50517,"dDurationMs":3086,"segs":[{"utf8":"hours of the 13th.\nAnd with a new moon"}]},{"tStartMs":53603,"dDurationMs":4071,"segs":[{"utf8":"arriving on the 12th,\nthe skies will be ideally dark."}]},{"tStartMs":57707,"dDurationMs":3337,"segs":[{"utf8":"The Perseids happen every year\nwhen Earth passes through"}]},{"tStartMs":61044,"dDurationMs":4187,"segs":[{"utf8":"a debris stream left\nbehind by Comet Swift-Tuttle."}]},{"tStartMs":65231,"dDurationMs":2803,"segs":[{"utf8":"As those tiny bits of comet\ndust hit our atmosphere"}]},{"tStartMs":68034,"dDurationMs":3721,"segs":[{"utf8":"at high speed, they burn up\nas bright streaks of light."}]},{"tStartMs":71838,"dDurationMs":1635,"segs":[{"utf8":"To view this meteor shower,"}]},{"tStartMs":73473,"dDurationMs":3520,"segs":[{"utf8":"look toward the northeast once\nit's fully dark, and watch"}]},{"tStartMs":76993,"dDurationMs":3003,"segs":[{"utf8":"for the Perseus constellation\nto clear the horizon."}]},{"tStartMs":80113,"dDurationMs":2169,"segs":[{"utf8":"This is where the meteors\noriginate,"}]},{"tStartMs":82282,"dDurationMs":3270,"segs":[{"utf8":"but let your eyes wander\nbecause they can flash across"}]},{"tStartMs":85552,"dDurationMs":1735,"segs":[{"utf8":"any part of the sky."}]},{"tStartMs":87987,"dDurationMs":1936,"segs":[{"utf8":"On August 14th through 16th,"}]},{"tStartMs":89923,"dDurationMs":3470,"segs":[{"utf8":"Venus reaches its greatest\neastern elongation."}]},{"tStartMs":93393,"dDurationMs":4321,"segs":[{"utf8":"Look low in the western sky\nshortly after sunset for a"}]},{"tStartMs":97714,"dDurationMs":3487,"segs":[{"utf8":"bright object that will outshine\nevery star around it."}]},{"tStartMs":101551,"dDurationMs":4354,"segs":[{"utf8":"On the night of August 27th,\ncontinuing into August 28th "}]},{"tStartMs":105905,"dDurationMs":1368,"segs":[{"utf8":"for some time zones."}]},{"tStartMs":107273,"dDurationMs":1886,"segs":[{"utf8":"The full moon slips through "}]},{"tStartMs":109159,"dDurationMs":3637,"segs":[{"utf8":"Earth's shadow, resulting\nin a partial lunar eclipse."}]},{"tStartMs":112829,"dDurationMs":1952,"segs":[{"utf8":"It will be visible\nfor much of "}]},{"tStartMs":114781,"dDurationMs":3887,"segs":[{"utf8":"North and South America\nand parts of Europe and Africa."}]},{"tStartMs":119002,"dDurationMs":3920,"segs":[{"utf8":"At maximum eclipse,\nabout 93% of the Moon's"}]},{"tStartMs":122922,"dDurationMs":1752,"segs":[{"utf8":"diameter will be inside"}]}]}