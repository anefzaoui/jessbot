# Copy to .env and fill in. .env is gitignored — never commit secrets.

# LLM (any OpenAI-compatible endpoint; defaults shown)
OPENROUTER_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-6-luna

# Server (loopback by default; set HOST=0.0.0.0 only behind a reverse proxy)
# HOST=127.0.0.1
# PORT=3737
# PUBLIC_URL=http://localhost:3737
# NODE_ENV=production

# Behind a reverse proxy: which proxy may tell Jessbot the client's address (X-Forwarded-For).
# loopback (default: a proxy on the same machine), off (no proxy), a hop count, or addresses/CIDRs separated by commas.
# TRUST_PROXY=loopback

# The first admin account needs the setup code printed in the server log on first start. Set your own code here
# (8+ characters), or "off" only if nobody else can reach the server before you finish setting it up.
# JESSBOT_SETUP_CODE=

# Fallback timezone for people who haven't set one (IANA name). Useful on Windows, where Node may report a
# fixed-offset zone like Etc/GMT-1 that ignores daylight saving.
# JESSBOT_TIMEZONE=America/New_York

# Portable data locations (relative to the install folder)
# JESSBOT_HOME=data
# JESSBOT_TOOLS=tools
