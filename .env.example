# Copy to .env and fill in. .env is gitignored — never commit secrets.

# LLM (any OpenAI-compatible endpoint; defaults shown). A key written here moves into the database, encrypted, the next
# time Jessbot starts (and this line is removed); one set in the real environment is used as it is and never stored.
OPENROUTER_KEY=
# Another provider (docs/guide/providers.md), or pick it on the setup page: Ollama http://127.0.0.1:11434/v1 (no key),
# or any OpenAI-compatible service's address.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-6-luna

# Server (loopback by default; set HOST=0.0.0.0 only behind a reverse proxy)
# HOST=127.0.0.1
# PORT=3737
# The address people use to reach it, e.g. https://jessbot.example.org behind a reverse proxy. When set, links (invites)
# use it, and requests must name its host (or a loopback name). Leave unset for a local or LAN install.
# PUBLIC_URL=http://localhost:3737
# More host names or origins to answer to (comma-separated), e.g. ALLOWED_HOSTS=jessbot.lan,192.168.1.20
# ALLOWED_HOSTS=
# ALLOWED_ORIGINS=
# NODE_ENV=production

# Behind a reverse proxy: which proxy may tell Jessbot the client's address (X-Forwarded-For).
# loopback (default: a proxy on the same machine), off (no proxy), a hop count, or addresses/CIDRs separated by commas.
# TRUST_PROXY=loopback

# The first admin account needs the setup code printed in the server log on first start. Set your own code here
# (8+ characters), or "off" only if nobody else can reach the server before you finish setting it up.
# JESSBOT_SETUP_CODE=

# Fallback timezone for people who haven't set one (IANA name). Useful on Windows, where Node may report a
# fixed-offset zone like Etc/GMT-1 that ignores daylight saving.
# JESSBOT_TIMEZONE=America/New_York

# Portable data locations (relative to the install folder)
# JESSBOT_HOME=data
# JESSBOT_TOOLS=tools

# Chromium's sandbox for the agent's browser (docs/SECURITY-MODEL.md → Browser sandbox). auto (default): on where this
# system allows it, else the browser runs without it and Admin → Browser says why; on: required (the browser won't start
# without it); off: never.
# JESSBOT_BROWSER_SANDBOX=auto

# The install key that encrypts saved passwords, two-step sign-in seeds and the model key (docs/SECURITY.md → Secrets
# and data). Made here on first use; keep a copy with your backups. Or keep it in a file outside the data folder:
# JESSBOT_SECRET_FILE=/run/secrets/jessbot_key
# An older key that still opens what it encrypted (during npm run secrets:rotate, or to restore an older backup):
# JESSBOT_SECRET_PREVIOUS=
