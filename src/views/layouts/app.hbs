{{!--
  App shell: left rail (md+) · main column · right panel (xl+, else a sheet) · bottom tab bar (< md).
  Pages set: title, nav (active section), and optionally hidePanel / mainClass.
--}}
<!doctype html>
<html lang="en" class="h-full" data-bot-name="{{bot.name}}" data-asset-v="{{assetV}}"{{#if apiBase}} data-api-base="{{apiBase}}"{{/if}}{{#if seq}} data-seq="{{seq}}"{{else if user}} data-seq="0"{{/if}}>
<head>
  {{> shell/head}}
</head>
<body class="h-full overflow-hidden bg-canvas text-ink antialiased">
  <a href="#main" class="skip-link">Skip to content</a>

  <div class="app-shell flex h-dvh">
    {{> shell/rail}}

    <div class="flex min-w-0 flex-1 flex-col">
      <main id="main" tabindex="-1" class="@container/main relative {{default mainClass 'min-h-0 flex-1 overflow-y-auto'}}">
        {{{body}}}
      </main>
      {{> shell/tabbar}}
    </div>

    {{#unless hidePanel}}
      <aside class="app-panel hidden w-[360px] shrink-0 flex-col border-l border-line bg-chrome xl:flex" aria-label="Activity and approvals">
        {{> shell/panel prefix="aside"}}
      </aside>
    {{/unless}}
  </div>

  {{!-- Same panel as a sheet for smaller screens (opened from the avatar / status strip). --}}
  <dialog id="panel-sheet" class="sheet" aria-label="Activity and approvals">
    {{> shell/panel prefix="sheet" inSheet=true}}
  </dialog>

  {{> shell/cmdk}}
  {{!-- Ringing alarms / finished timers (server-rendered so a refresh keeps ringing; live via alarm.ring) --}}
  <div class="alarm-dock" data-alarm-dock>{{#each shell.ringing}}{{> alarm-ring this}}{{/each}}</div>
  <div id="toasts" class="toast-region" aria-live="polite" aria-atomic="false"></div>
  <div id="announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
  <script type="module" src="/js/main.js?v={{assetV}}"></script>
</body>
</html>
