{{#> setup/frame heading="Give it a brain." lead="Jessbot thinks with a language model: OpenRouter (every feature, very cheap), Ollama on your own computer, or any OpenAI-compatible service."}}
  <form class="space-y-4" data-model-test action="/setup/model/test">
    {{> setup/provider-fields}}

    <button type="submit" class="btn btn-secondary btn-block" data-test-button>{{icon "plug-zap" class="size-4"}} Test the connection</button>
    <div data-test-result aria-live="polite"></div>
  </form>

  <form method="post" action="/setup/model" class="mt-6 flex items-center gap-3">
    <button class="btn btn-primary btn-lg flex-1" data-continue {{#unless modelDone}}disabled{{/unless}}>Continue {{icon "arrow-right" class="size-4"}}</button>
    <button name="skip" value="1" class="btn btn-ghost">Skip for now</button>
  </form>
{{/setup/frame}}
<script type="module" src="/js/setup.js"></script>
