{{#> setup/frame heading="First, you." lead="You're the owner. You decide who else can talk to your agent and how it treats each of them."}}
  <form method="post" action="/setup/account" class="space-y-4" data-ajax data-busy="Creating your account…">
    {{#if needsClaim}}
      <div class="rounded-xl border border-warn/40 bg-warn-soft px-4 py-3 text-sm">
        <p class="font-semibold text-warn-text">You're setting up from another device.</p>
        <p class="mt-1 text-ink-2">Enter the setup code printed in the server console so nobody else can claim this install.</p>
      </div>
      {{> field name="claim" label="Setup code" placeholder="ABCD-1234" autocomplete="off" required=true}}
    {{/if}}
    {{> field name="name" label="Your name" autocomplete="name" required=true autofocus=true}}
    {{> field name="email" label="Email" type="email" autocomplete="email" required=true hint="Used to sign in. Nothing is sent anywhere."}}
    {{> field name="password" label="Password" type="password" autocomplete="new-password" required=true hint="At least 10 characters. A short sentence works well."}}
    <input type="hidden" name="timezone" data-tz-default>
    <button class="btn btn-primary btn-lg btn-block mt-2">Create my account {{icon "arrow-right" class="size-4"}}</button>
  </form>
{{/setup/frame}}
