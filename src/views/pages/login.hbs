{{#> auth-frame heading=(t "Welcome back") lead=(iff setupUnfinished (t "Setup isn’t finished yet. Sign in with the account you made to carry on where you left off.") (t "Sign in to talk to {name}." name=bot.name))}}
  {{#if resetDone}}<p class="mb-4 rounded-lg border border-ok/30 bg-ok-soft px-3 py-2 text-[13px]" role="status" data-reset-done>{{t "Your new password is saved. Sign in with it."}}</p>{{/if}}
  <form method="post" action="/login" class="space-y-4" data-ajax data-busy="{{t "Signing in…"}}">
    <input type="hidden" name="next" value="{{next}}">
    {{> field name="email" label=(t "Email") type="email" autocomplete="username" required=true autofocus=true}}
    {{> field name="password" label=(t "Password") type="password" autocomplete="current-password" required=true}}
    <button class="btn btn-primary btn-lg btn-block mt-2">{{t "Sign in"}} {{icon "arrow-right" class="size-4 rtl:-scale-x-100"}}</button>
  </form>
  {{#unless setupUnfinished}}<p class="mt-6 text-center text-xs text-ink-3">{{t "No account? Ask the person who runs this {name} for an invite link." name=bot.name}}</p>{{/unless}}
{{/auth-frame}}
