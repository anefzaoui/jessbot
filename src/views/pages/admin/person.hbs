{{#> page-header title=person.name subtitle=(concat (iff (eq person.role 'admin') 'Admin' 'Member') (iff person.email (concat ' · ' person.email) '')) width="max-w-5xl"}}
  <a href="/admin/people" class="btn btn-ghost btn-sm">{{icon "arrow-left" class="size-4"}} People</a>
{{/page-header}}
<div class="mx-auto max-w-5xl px-4 py-6 sm:px-6">
  {{> admin/nav active="people"}}

  <div class="grid gap-6 @4xl/main:grid-cols-[1fr_300px]">
    <div class="space-y-6">
      <section class="card p-5" aria-labelledby="h-instr">
        <div class="flex items-start gap-3">
          {{> person name=person.name hue=person.hue size="size-9 text-xs"}}
          <div class="min-w-0 flex-1">
            <h2 id="h-instr" class="text-sm font-semibold">How {{bot.name}} treats {{person.firstName}}</h2>
            <p class="text-xs text-ink-3">Tone, what to help with, what to avoid, what to always keep in mind. Only admins see this.</p>
          </div>
        </div>
        {{> admin/instructions-form action=(concat '/admin/people/' person.id '/instructions') current=instructions max=instructionsMax
          placeholder=(concat "e.g. " person.firstName " is 12. Keep answers age-appropriate, help with homework by explaining rather than giving answers, no purchases, remind about piano practice on Tuesdays.")}}
        {{#if history.[1]}}
          <details class="mt-4">
            <summary class="cursor-pointer text-xs font-medium text-ink-3 hover:text-ink-2">Previous versions ({{history.length}})</summary>
            <ol class="mt-3 space-y-3" role="list">
              {{#each history}}{{#unless @first}}
                <li class="rounded-lg border border-line bg-surface-2/50 p-3">
                  <p class="text-xs text-ink-3"><time datetime="{{iso created_at}}">{{date created_at}}</time>{{#if author_name}} · {{author_name}}{{/if}}</p>
                  <p class="mt-1 text-sm whitespace-pre-wrap text-ink-2">{{default body '(empty)'}}</p>
                </li>
              {{/unless}}{{/each}}
            </ol>
          </details>
        {{/if}}
      </section>

      <section class="card p-5" aria-labelledby="h-perms">
        <h2 id="h-perms" class="text-sm font-semibold">What {{bot.name}} may do for {{person.firstName}}</h2>
        <p class="mb-4 text-xs text-ink-3">Leave “Inherit” to follow their groups and the defaults for everyone.</p>
        {{> admin/policy-form policy}}
        {{#if grants}}
          <h3 class="mt-6 mb-2 text-xs font-semibold text-ink-2">“Always allow” permissions {{person.firstName}} granted</h3>
          <ul class="divide-y divide-line rounded-xl border border-line" role="list">
            {{#each grants}}
              <li class="flex items-center gap-3 px-4 py-2.5 text-sm">
                <span class="font-mono text-xs">{{tool}}</span>
                <time class="text-xs text-ink-3" datetime="{{iso created_at}}" data-relative>{{timeAgo created_at}}</time>
                <form method="post" action="/admin/people/{{@root.person.id}}/grants/{{id}}/revoke" class="ml-auto" data-ajax data-stay data-remove-closest="li" data-success="Permission removed. It will ask again next time.">
                  <button class="btn btn-ghost btn-sm">Revoke</button>
                </form>
              </li>
            {{/each}}
          </ul>
        {{/if}}
      </section>
    </div>

    <aside class="space-y-6">
      <section class="card p-5" aria-labelledby="h-groups">
        <h2 id="h-groups" class="text-sm font-semibold">Groups</h2>
        {{#if groups}}
          <form method="post" action="/admin/people/{{person.id}}/groups" class="mt-3 space-y-2" data-ajax data-stay data-success="Groups updated.">
            {{#each groups}}
              <label class="flex items-center gap-2.5 text-sm"><input type="checkbox" class="check" name="groups" value="{{id}}" {{#if (includes @root.memberOf id)}}checked{{/if}}> {{name}}</label>
            {{/each}}
            <button class="btn btn-secondary btn-sm mt-2">Save groups</button>
          </form>
        {{else}}
          <p class="mt-2 text-xs text-ink-3">No groups yet. <a href="/admin/groups" class="font-medium text-accent-text hover:underline">Create one</a>.</p>
        {{/if}}
      </section>

      {{#unless isSelf}}
        <section class="card p-5" aria-labelledby="h-chats">
          <h2 id="h-chats" class="text-sm font-semibold">Their chats</h2>
          {{#unless oversight}}
          <p class="mt-0.5 text-xs text-ink-3">Private to them. Admins can read chats only when “Let admins read other people’s chats” is on in <a href="/admin/people" class="font-medium text-accent-text hover:underline">People</a>, and then everyone is told.</p>
          {{else}}
          <p class="mt-0.5 text-xs text-ink-3">Read-only. Opening one is logged.</p>
          <ul class="mt-2 space-y-1 text-sm" role="list">
            {{#each threads}}<li><a href="/chat/{{id}}" class="flex items-center gap-2 rounded-md px-1 py-1 text-ink-2 hover:bg-surface-2 hover:text-ink">{{icon "message-circle" class="size-4 text-ink-3"}}<span class="flex-1 truncate">{{#if (eq kind 'main')}}Main chat{{else}}{{title}}{{/if}}</span><time class="text-xs text-ink-3" datetime="{{iso last_activity_at}}" data-relative>{{timeAgo last_activity_at}}</time></a></li>
            {{else}}<li class="text-xs text-ink-3">No chats yet.</li>{{/each}}
          </ul>
          {{/unless}}
        </section>
      {{/unless}}

      <section class="card p-5" aria-labelledby="h-devices">
        <h2 id="h-devices" class="text-sm font-semibold">Signed-in devices</h2>
        <ul class="mt-2 space-y-2 text-sm" role="list">
          {{#each sessions}}<li class="flex items-center gap-2 text-ink-2">{{icon "monitor" class="size-4 text-ink-3"}} <span class="flex-1 truncate">{{device}}</span> <time class="text-xs text-ink-3" datetime="{{iso lastSeen}}" data-relative>{{timeAgo lastSeen}}</time></li>
          {{else}}<li class="text-xs text-ink-3">Not signed in anywhere.</li>{{/each}}
        </ul>
      </section>

      {{#unless isSelf}}
        <section class="card p-5" aria-labelledby="h-signin-help">
          <h2 id="h-signin-help" class="text-sm font-semibold">Signing in</h2>
          <p class="mt-1 text-xs text-ink-3">Two-step sign-in is {{#if twoFactorOn}}<span class="font-medium text-ink-2">on</span>{{else}}off{{/if}} for {{person.firstName}}.</p>
          <form method="post" action="/admin/people/{{person.id}}/reset-link" class="mt-3" data-ajax data-stay data-busy="Making the link…" data-reset-link-form>
            <button class="btn btn-secondary btn-sm">{{icon "key-round" class="size-4"}} Make a password reset link</button>
          </form>
          <div class="mt-3" data-reset-link-box></div>
          {{#if twoFactorOn}}
            <form method="post" action="/admin/people/{{person.id}}/2fa-off" class="mt-3" data-ajax data-confirm="Turn off two-step sign-in for {{person.firstName}}? Only do this if they lost their phone and their recovery codes; they'll be signed out everywhere.">
              <button class="btn btn-danger-ghost btn-sm">{{icon "shield-alert" class="size-4"}} Turn off two-step sign-in</button>
            </form>
          {{/if}}
        </section>

        <section class="card p-5" aria-labelledby="h-access">
          <h2 id="h-access" class="text-sm font-semibold">Access</h2>
          <form method="post" action="/admin/people/{{person.id}}/status" class="mt-3" data-ajax data-confirm="{{#if (eq person.status 'active')}}Disable {{person.firstName}}? They'll be signed out everywhere.{{/if}}">
            {{#if (eq person.status 'active')}}
              <input type="hidden" name="status" value="disabled"><button class="btn btn-danger-ghost btn-sm">{{icon "user-x" class="size-4"}} Disable account</button>
            {{else}}
              <input type="hidden" name="status" value="active"><button class="btn btn-secondary btn-sm">{{icon "user-check" class="size-4"}} Re-enable account</button>
            {{/if}}
          </form>
        </section>
      {{/unless}}
    </aside>
  </div>
</div>
