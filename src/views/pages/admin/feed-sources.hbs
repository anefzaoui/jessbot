{{!-- Admin → Feed sources (decision #89). Data: sources [admin/feed-source-row source], counts { total, failing, followers, items }.
  Client: public/js/admin-feed.js (filter · Fetch now · Remove for everyone). --}}
{{> page-header title="Feed sources" subtitle="Every source the Feed reads, who follows it, and whether it answers" width="max-w-5xl"}}
<div class="mx-auto max-w-5xl px-4 py-6 sm:px-6" data-admin-feed>
  {{> admin/nav active="feed"}}

  <div class="src-summary" data-src-summary>
    <div><p class="src-stat tabular" data-count="total">{{counts.total}}</p><p class="src-stat-label">sources</p></div>
    <div><p class="src-stat tabular">{{counts.followers}}</p><p class="src-stat-label">people following</p></div>
    <div><p class="src-stat tabular">{{counts.items}}</p><p class="src-stat-label">stories stored</p></div>
    <div data-bad="{{#if counts.failing}}true{{else}}false{{/if}}"><p class="src-stat tabular" data-count="failing">{{counts.failing}}</p><p class="src-stat-label">not answering</p></div>
  </div>

  <p class="mt-4 mb-4 text-sm text-ink-2">Sources are shared: each is fetched once for everyone who follows it. People manage their own on
    <a href="/feed/sources" class="font-medium text-accent-text">Feed → Sources</a>. Removing one here removes it for everyone, and their re-tunes won’t bring it back.</p>

  {{#if sources}}
    <div class="mb-3 flex flex-wrap gap-1.5" role="group" aria-label="Show">
      <button type="button" class="chip" data-admin-feed-filter="all" aria-pressed="true">All</button>
      <button type="button" class="chip" data-admin-feed-filter="failing" aria-pressed="false">{{icon "circle-alert" class="size-3.5"}} Not answering</button>
      <button type="button" class="chip" data-admin-feed-filter="gnews" aria-pressed="false">{{icon "search" class="size-3.5"}} Google News</button>
      <button type="button" class="chip" data-admin-feed-filter="rss" aria-pressed="false">{{icon "rss" class="size-3.5"}} Site feeds</button>
    </div>
    <ul class="card overflow-hidden p-0" role="list" data-admin-source-list>
      {{#each sources}}{{> admin/feed-source-row source=this}}{{/each}}
    </ul>
    <p class="mt-3 hidden text-center text-sm text-ink-3" data-admin-feed-empty>Nothing matches that filter.</p>
  {{else}}
    {{#> empty-state iconName="rss" title="No sources yet" text="Sources appear when someone tunes their Feed."}}{{/empty-state}}
  {{/if}}
</div>
