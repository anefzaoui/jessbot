<main id="main" class="grid min-h-dvh place-items-center px-6 py-16">
  <div class="max-w-md text-center">
    <div class="mx-auto mb-6 w-fit">{{> avatar size="xl" state="error"}}</div>
    <p class="font-mono text-sm tabular-nums text-ink-3">{{code}}</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-balance">{{title}}</h1>
    <p class="mt-3 text-ink-2 text-pretty">{{message}}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn btn-primary">{{icon "house" class="size-4"}} Back home</a>
    </div>
  </div>
</main>
