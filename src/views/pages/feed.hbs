{{!--
  Feed — Google Discover quality (decision #34).
  Data: feed { greeting: { text, date, line?, weather?: { temp, label, iconName } }, prompt, topics: [{ label, when?, active }],
               diet?: (feed/diet, home only), mode: ranked|search|history|story,
               filters: { topic?, saved, q }, home, brief?: (feed/brief), sections: (feed/sections), next?: cursor, count,
               status: { state: idle|working|error|null, note? }, working: bool }  (services/feed.js feedData)
  Live: feed.progress { state, note } → status line · feed.updated → "New stories" pill (feed.js).
--}}
<div class="feed-page mx-auto max-w-2xl px-3 pb-16 sm:px-6" data-feed data-pull-refresh>
  <div class="pull-indicator" aria-hidden="true" data-pull-indicator>{{icon "refresh-cw" class="size-4"}}</div>

  {{!-- Greeting hero on the living sky --}}
  <header class="feed-hero-head relative mt-3 overflow-hidden rounded-3xl sm:mt-6"
    {{#if presence.cover.url}}style="--scene: url('{{presence.cover.url}}')"{{/if}} {{#if presence.cover.live}}data-sky{{/if}} data-time="{{presence.time}}">
    <div class="relative z-10 flex items-end gap-4 p-5 sm:p-7">
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-white/80">{{feed.greeting.date}}</p>
        <h1 class="mt-1 text-2xl leading-tight font-semibold tracking-tight text-balance text-white sm:text-3xl">{{feed.greeting.text}}</h1>
        {{#if feed.greeting.weather}}
          <p class="mt-2 flex items-center gap-1.5 text-sm text-white/90">{{icon feed.greeting.weather.iconName class="size-4"}}
            <span class="tabular font-semibold">{{feed.greeting.weather.temp}}</span> · {{feed.greeting.weather.label}}</p>
        {{/if}}
        {{#if feed.greeting.line}}<p class="mt-3 max-w-md text-[15px] text-white/85 text-pretty">“{{feed.greeting.line}}”</p>{{/if}}
      </div>
      <button type="button" class="shrink-0 rounded-full" data-panel-open="activity" aria-label="Open {{bot.name}}'s activity">{{> avatar size="xl" activity="resting"}}</button>
    </div>
  </header>

  {{!-- Following + tune --}}
  <form method="get" action="/feed" class="relative mt-4" role="search" data-feed-search>
    <label for="feed-q" class="sr-only">Search your feed</label>
    <span class="pointer-events-none absolute inset-y-0 left-3 grid place-items-center text-ink-3">{{icon "search" class="size-4"}}</span>
    <input id="feed-q" name="q" type="search" value="{{feed.filters.q}}" placeholder="Search every story and article" class="input h-10 rounded-full pl-9" autocomplete="off" enterkeyhint="search">
  </form>

  <nav class="-mx-3 mt-3 flex items-center gap-1.5 overflow-x-auto px-3 pb-1 sm:mx-0 sm:px-0" aria-label="Topics">
    <a href="/feed" class="chip shrink-0" {{#if feed.home}}aria-current="page"{{/if}}>For you</a>
    {{#each feed.topics}}<a href="/feed?topic={{urlencode label}}" class="chip shrink-0" {{#if active}}aria-current="page"{{/if}}>{{label}}</a>{{/each}}
    <a href="/feed?saved=1" class="chip shrink-0" {{#if feed.filters.saved}}aria-current="page"{{/if}}>{{icon "bookmark" class="size-3.5"}} Saved</a>
    <a href="/feed?history=1" class="chip shrink-0" {{#if feed.filters.history}}aria-current="page"{{/if}}>{{icon "history" class="size-3.5"}} History</a>
    <button type="button" class="chip shrink-0" data-modal-open="tune-feed">{{icon "sliders-horizontal" class="size-3.5"}} Tune</button>
    {{#if feed.topics}}<button type="button" class="chip shrink-0" data-feed-refresh aria-label="Look for new stories now">{{icon "refresh-cw" class="size-3.5"}} Refresh</button>{{/if}}
  </nav>

  {{!-- What Jess is doing for the feed right now (survives refresh: the state lives in feed_prefs) --}}
  <p class="feed-status" role="status" data-feed-status data-state="{{#if feed.working}}working{{else}}{{feed.status.state}}{{/if}}"
    {{#unless (or feed.working (and feed.status.note (neq feed.status.state 'working')))}}hidden{{/unless}}>
    <span class="feed-status-icon" aria-hidden="true">{{icon "loader-circle" class="size-4 spin"}}{{icon "circle-alert" class="size-4 err"}}{{icon "info" class="size-4 info"}}</span>
    <span data-feed-status-text>{{#if feed.working}}{{default feed.status.note 'Working on your feed…'}}{{else}}{{feed.status.note}}{{/if}}</span>
  </p>
  <button type="button" class="feed-new-pill" data-feed-new hidden>{{icon "arrow-up" class="size-4"}} New stories</button>

  <div class="mt-5 space-y-4" data-feed-stream>
    {{#if feed.filters.q}}
      <p class="flex items-center gap-2 px-1 text-sm text-ink-2">
        {{#if feed.count}}Stories matching “{{feed.filters.q}}”{{else}}Nothing matches “{{feed.filters.q}}” yet.{{/if}}
        <a href="/feed" class="ml-auto text-xs font-medium text-accent-text">Clear search</a>
      </p>
    {{/if}}
    {{#if feed.brief}}{{> feed/brief brief=feed.brief}}{{/if}}
    {{#if feed.diet}}{{> feed/diet diet=feed.diet}}{{/if}}

    <div class="space-y-4" data-feed-list data-mode="{{feed.mode}}">{{> feed/sections sections=feed.sections}}</div>

    {{#if feed.next}}
      <div class="flex justify-center py-4">
        <button type="button" class="btn btn-secondary" data-feed-more data-next="{{feed.next}}">{{#if (eq feed.mode 'history')}}{{icon "history" class="size-4"}} Show older stories{{else}}{{icon "chevrons-down" class="size-4"}} Show more stories{{/if}}</button>
      </div>
    {{else if feed.sections}}
      <div class="flex flex-col items-center py-8 text-center" data-feed-end>
        <span class="grid size-11 place-items-center rounded-full bg-ok-soft text-ok">{{icon "check-check" class="size-5"}}</span>
        <p class="mt-2 text-sm font-semibold">{{#if feed.home}}You're all caught up{{else}}That's everything here{{/if}}</p>
        <p class="text-xs text-ink-3">{{#if feed.home}}New stories arrive on your schedule.{{else}}<a href="/feed" class="text-accent-text">Back to For you</a>{{/if}}</p>
      </div>
    {{else if feed.home}}
      {{#unless feed.brief}}
        {{#> empty-state iconName="newspaper" title="Your feed is warming up" text="Tell me what you care about and I'll write stories just for you. No ads, no noise."}}
          <button type="button" class="btn btn-primary" data-modal-open="tune-feed">{{icon "sliders-horizontal" class="size-4"}} Tune my feed</button>
        {{/empty-state}}
      {{/unless}}
    {{else if feed.filters.history}}
      {{#> empty-state iconName="history" title="Nothing here yet" text="Stories you open, like or save, and the ones I write for you, collect here by day."}}{{/empty-state}}
    {{else if feed.filters.saved}}
      {{#> empty-state iconName="bookmark" title="Nothing saved yet" text="Tap the bookmark on any story to keep it here."}}{{/empty-state}}
    {{else if (eq feed.mode 'story')}}
      {{!-- A story link (from chat, #192) whose story is gone: too old and cleared, or from a source they stopped following. --}}
      {{#> empty-state iconName="newspaper" title="That story isn’t here any more" text="Older stories are cleared after a while, and stories from sources you stopped following go with them. Your feed has what’s new."}}
        <a href="/feed" class="btn btn-primary">{{icon "arrow-left" class="size-4"}} Back to your feed</a>
      {{/empty-state}}
    {{/if}}
  </div>
</div>

{{!-- Tune the feed --}}
<dialog id="tune-feed" class="modal" aria-labelledby="tune-title">
  <form data-ajax data-stay method="post" action="{{default feed.saveUrl '/api/v1/feed/prompt'}}" data-success="Got it. I'll tune your feed to match." data-busy="Saving…">
    <div class="modal-header">
      <div><h2 id="tune-title" class="text-base font-semibold">What do you want to see?</h2>
        <p class="text-sm text-ink-3">Topics, sources, times of day. Be as specific as you like.</p></div>
      <button type="button" class="btn btn-ghost btn-icon btn-sm" data-modal-close aria-label="Close">{{icon "x" class="size-4"}}</button>
    </div>
    <div class="modal-body">
      <label for="feed-prompt" class="sr-only">Feed instructions</label>
      <textarea id="feed-prompt" name="prompt" class="textarea min-h-28 text-sm" placeholder="e.g. Finance news in the morning, non-fiction book picks in the evening, new AI releases daily.">{{feed.prompt}}</textarea>
      {{#if feed.topics}}
        <div class="mt-3 flex flex-wrap gap-1.5">{{#each feed.topics}}<span class="chip h-7 cursor-default text-xs">{{#if when}}<span class="text-ink-3">{{when}} ·</span>{{/if}} {{label}}</span>{{/each}}</div>
      {{/if}}
      <a href="/feed/sources" class="mt-3 flex items-center gap-3 rounded-xl border border-line px-3.5 py-2.5 text-sm transition hover:border-accent/40 hover:bg-accent-soft/40">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent-text">{{icon "rss" class="size-4"}}</span>
        <span class="min-w-0 flex-1"><span class="block font-medium">Review your sources</span>
          <span class="block text-xs text-ink-3">See where stories come from, add sites, remove or pause any. Your changes stay when you update.</span></span>
        {{icon "chevron-right" class="size-4 text-ink-3"}}
      </a>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-modal-close>Cancel</button><button class="btn btn-primary">Update my feed</button></div>
  </form>
</dialog>

{{!-- Reading sheet --}}
<dialog id="feed-reader" class="sheet reader-sheet" aria-labelledby="reader-title">
  <div class="flex h-full flex-col">
    <header class="flex items-center gap-2 border-b border-line px-4 py-2.5">
      <button type="button" class="btn btn-ghost btn-icon btn-sm" data-modal-close aria-label="Close">{{icon "x" class="size-[18px]"}}</button>
      <p class="min-w-0 flex-1 truncate text-sm font-medium text-ink-2" data-reader-source></p>
      <a href="#" class="btn btn-ghost btn-sm" data-reader-ask>{{icon "message-circle" class="size-4"}} Ask</a>
    </header>
    <div class="min-h-0 flex-1 overflow-y-auto">
      <div class="feed-cover aspect-video" data-reader-cover></div>
      <article class="px-5 pt-5 pb-10 sm:px-8">
        <h2 id="reader-title" class="text-2xl leading-tight font-semibold tracking-tight text-balance" data-reader-title></h2>
        <p class="mt-3 flex items-center gap-2 text-sm font-semibold text-accent-text">{{> avatar size="xs" activity="resting"}} {{bot.name}}’s take</p>
        <div class="prose-jb mt-2" data-reader-body></div>

        <section class="mt-8 border-t border-line pt-6" aria-labelledby="reader-full" data-reader-full>
          <h3 id="reader-full" class="text-sm font-semibold text-ink-2">Full article <span class="font-normal" data-reader-source-line></span></h3>
          <div class="mt-3" data-reader-article aria-live="polite"></div>
        </section>

        <a href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary mt-8 w-full" data-reader-original hidden>
          {{icon "external-link" class="size-4"}} <span>Open the original</span>
        </a>
      </article>
    </div>
  </div>
</dialog>
