{{!--
  Proactive idea.
  Contract: { id, title, why, category, iconName, sourceLabel?, sourceHref?, isNew? }
--}}
<article class="idea-card card card-hover flex flex-col p-4" data-idea-id="{{id}}" data-category="{{category}}" aria-labelledby="idea-{{id}}">
  <div class="flex items-start gap-2">
    <h3 id="idea-{{id}}" class="min-w-0 flex-1 leading-snug font-semibold text-balance">{{title}}</h3>
    {{#if isNew}}<span class="badge badge-accent mt-0.5">New</span>{{/if}}
  </div>
  <p class="mt-2 text-[13px] leading-relaxed text-ink-2">{{why}}</p>
  <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-3">
    <span class="inline-flex items-center gap-1.5">{{icon (default iconName "lightbulb") class="size-3.5"}} {{category}}</span>
    {{#if sourceLabel}}
      <a href="{{sourceHref}}" class="inline-flex items-center gap-1 hover:text-ink-2">{{icon "message-circle" class="size-3.5"}} From {{sourceLabel}}</a>
    {{/if}}
  </p>
  <div class="mt-auto flex items-center gap-2 pt-4">
    <button type="button" class="btn btn-primary btn-sm" data-idea-action="start">Let's do it</button>
    <button type="button" class="btn btn-ghost btn-sm" data-idea-action="snooze">Later</button>
    <button type="button" class="btn btn-ghost btn-icon btn-sm ml-auto" data-idea-action="dismiss" data-tooltip="Not for me" aria-label="Not for me">{{icon "x" class="size-4"}}</button>
  </div>
</article>
