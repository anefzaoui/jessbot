{{!-- Left rail (md+). Collapses to icons; state persisted (jb-rail) and restored before paint. --}}
<nav class="rail hidden shrink-0 flex-col border-r border-line bg-chrome md:flex" aria-label="Primary">
  <div class="flex h-14 items-center gap-2.5 px-3">
    <a href="/chat" class="flex min-w-0 items-center gap-2.5 rounded-lg p-1" data-tooltip="{{bot.name}}" data-tooltip-rail>
      {{> avatar size="sm" activity=shell.agent.activity avatarId="rail-avatar"}}
      <span class="rail-label truncate text-[15px] font-semibold tracking-tight">{{bot.name}}</span>
    </a>
    <button type="button" class="rail-label btn btn-ghost btn-icon btn-sm ml-auto" data-rail-toggle
      data-tooltip="Collapse sidebar" data-tooltip-kbd="Ctrl [" aria-label="Collapse sidebar">
      {{icon "panel-left-close" class="size-[18px]"}}
    </button>
  </div>

  <div class="px-3 pb-2">
    <button type="button" class="rail-search flex h-9 w-full items-center gap-2.5 rounded-lg border border-line bg-surface px-2.5 text-sm text-ink-3 transition hover:border-line-strong hover:text-ink-2"
      data-cmdk-open data-tooltip="Search & commands" data-tooltip-kbd="Ctrl K" data-tooltip-rail>
      {{icon "search" class="size-4"}}
      <span class="rail-label flex-1 text-start">Search or jump to…</span>
      <span class="rail-label kbd">Ctrl K</span>
    </button>
  </div>

  <div class="flex flex-col gap-0.5 px-3 py-1">
    {{#each shell.navItems}}
      <a href="{{href}}" class="rail-link" {{#if (eq key ../nav)}}aria-current="page"{{/if}}
        data-cmd="{{label}}" data-cmd-group="Go to" data-cmd-icon="{{iconName}}" data-tooltip="{{label}}" data-tooltip-rail>
        {{icon iconName class="size-[18px]"}}
        <span class="rail-label flex-1">{{label}}</span>
        {{#if count}}<span class="rail-label count" data-live-count="{{key}}">{{count}}</span>{{/if}}
      </a>
    {{/each}}
    {{!-- Schedule and history: always one click away (owner: "no visible way to /upcoming") --}}
    <div class="my-1.5 border-t border-line"></div>
    <a href="/upcoming" class="rail-link" {{#if (eq title "Upcoming")}}aria-current="page"{{/if}}
      data-cmd="Upcoming: alarms, reminders, scheduled tasks" data-cmd-group="Go to" data-cmd-icon="calendar-clock" data-tooltip="Upcoming" data-tooltip-rail>
      {{icon "calendar-clock" class="size-[18px]"}}<span class="rail-label flex-1">Upcoming</span>
    </a>
    <a href="/activity" class="rail-link" {{#if (eq title "Activity")}}aria-current="page"{{/if}}
      data-cmd="Activity: everything I did" data-cmd-group="Go to" data-cmd-icon="history" data-tooltip="Activity" data-tooltip-rail>
      {{icon "history" class="size-[18px]"}}<span class="rail-label flex-1">Activity</span>
    </a>
  </div>

  <div class="rail-label mt-4 flex min-h-0 flex-1 flex-col overflow-y-auto">
    {{!-- Projects (docs/PROJECTS.md): continuous chats with their own brief and files. + starts the interview in Main. --}}
    <div class="flex items-center justify-between px-5 pb-1">
      <a href="/projects" class="eyebrow hover:text-ink-2" data-cmd="All projects" data-cmd-group="Go to" data-cmd-icon="folders">Projects</a>
      <button type="button" class="btn btn-ghost btn-icon btn-sm -mr-1.5" data-project-new data-tooltip="New project" aria-label="New project"
        data-cmd="New project" data-cmd-group="Actions" data-cmd-icon="folder-plus">
        {{icon "plus" class="size-4"}}
      </button>
    </div>
    <div data-rail-projects-slot>{{> projects/rail-list projects=shell.projects}}</div>

    <div class="mt-3 flex items-center justify-between px-5 pb-1">
      <h2 class="eyebrow">Side chats</h2>
      <a href="/chat/new" class="btn btn-ghost btn-icon btn-sm -mr-1.5" data-tooltip="New side chat" aria-label="New side chat"
        data-cmd="New side chat" data-cmd-group="Actions" data-cmd-icon="message-square-plus">
        {{icon "plus" class="size-4"}}
      </a>
    </div>
    <ul class="px-3 pb-2" role="list">
      {{#each shell.sideChats}}
        <li>
          <a href="/chat/{{id}}" class="rail-link h-8 text-[13px]" {{#if active}}aria-current="page"{{/if}} data-cmd="{{title}}" data-cmd-group="Side chats" data-cmd-icon="message-square">
            {{#if running}}<span class="grid size-[18px] place-items-center"><span class="dot dot-run" aria-label="Working"></span></span>
            {{else if (eq background 'delegate')}}{{icon "rocket" class="size-[18px] text-ink-3"}}
            {{else if (eq background 'prep')}}{{icon "moon" class="size-[18px] text-ink-3"}}
            {{else}}{{icon "message-square" class="size-[18px] text-ink-3"}}{{/if}}
            <span class="flex-1 truncate">{{title}}</span>
            {{#if background}}<span class="rail-bg-tag" data-tooltip="{{#if (eq background 'prep')}}Prepared overnight{{else}}A background task{{/if}}">{{#if (eq background 'prep')}}Overnight{{else}}Background{{/if}}</span>{{/if}}
          </a>
        </li>
      {{else}}
        <li class="px-2.5 py-2 text-xs leading-relaxed text-ink-3">Branch off a topic without cluttering your main chat.</li>
      {{/each}}
    </ul>
  </div>

  <div class="mt-auto flex flex-col gap-1 border-t border-line p-3">
    {{#if (eq user.role "admin")}}
      <a href="/admin" class="rail-link" {{#if (eq nav "admin")}}aria-current="page"{{/if}}
        data-cmd="Admin dashboard" data-cmd-group="Go to" data-cmd-icon="shield" data-tooltip="Admin" data-tooltip-rail>
        {{icon "shield" class="size-[18px]"}}<span class="rail-label">Admin</span>
      </a>
    {{/if}}

    {{#if shell.usage}}
      <a href="/me/usage" class="rail-label group block rounded-lg px-2.5 py-2 hover:bg-surface-2">
        <div class="flex items-center justify-between text-xs">
          <span class="font-medium text-ink-2">Usage this week</span>
          <span class="tabular text-ink-3">{{#if shell.usage.limited}}{{shell.usage.pct}}%{{else}}{{shell.usage.spentLabel}}{{/if}}</span>
        </div>
        <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-surface-3" role="progressbar"
          aria-valuenow="{{shell.usage.pct}}" aria-valuemin="0" aria-valuemax="100" aria-label="Weekly usage">
          <div class="h-full rounded-full {{#if (gt shell.usage.pct 80)}}bg-warn{{else}}bg-accent{{/if}}" style="width: {{shell.usage.pct}}%"></div>
        </div>
        <p class="mt-1 text-[11px] text-ink-3">{{shell.usage.label}}</p>
      </a>
    {{/if}}

    {{> shell/user-menu}}

    <button type="button" class="rail-expand btn btn-ghost btn-icon mx-auto hidden" data-rail-toggle
      data-tooltip="Expand sidebar" data-tooltip-kbd="Ctrl [" aria-label="Expand sidebar">
      {{icon "panel-left-open" class="size-[18px]"}}
    </button>
  </div>
</nav>
