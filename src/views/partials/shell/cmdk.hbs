{{!-- Command palette (Ctrl/⌘+K). Commands are collected from [data-cmd] elements + built-ins (cmdk.js). --}}
<dialog id="cmdk" class="modal modal-lg mt-[12vh] mb-auto max-w-xl" aria-label="Search and commands">
  <div class="flex items-center gap-3 border-b border-line px-4">
    {{icon "search" class="size-[18px] text-ink-3"}}
    <input type="text" class="h-14 flex-1 bg-transparent text-[15px] outline-none placeholder:text-ink-3"
      placeholder="Search pages, actions, chats…" aria-label="Search commands" role="combobox"
      aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" data-cmdk-input>
    <span class="kbd">Esc</span>
  </div>
  <ul id="cmdk-list" role="listbox" class="max-h-[50vh] overflow-y-auto p-2" data-cmdk-list></ul>
  <div class="flex items-center gap-4 border-t border-line px-4 py-2 text-[11px] text-ink-3">
    <span class="flex items-center gap-1"><span class="kbd">↑</span><span class="kbd">↓</span> navigate</span>
    <span class="flex items-center gap-1"><span class="kbd">↵</span> open</span>
    <span class="ml-auto flex items-center gap-1">Ask {{bot.name}} directly: type and press <span class="kbd">Tab</span></span>
  </div>
</dialog>
