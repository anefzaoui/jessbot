{{!--
  The Lists index body: the lists as cards, then the archived ones (Restore). The page renders it and
  GET /api/v1/lists?fragment=1 re-renders it live (list.updated). Data: page = services/lists.js listsPage().
--}}
<div data-lists-body>
  {{#if page.lists}}
    <div class="grid gap-4 @xl/main:grid-cols-2 @4xl/main:grid-cols-3">
      {{#each page.lists}}{{> lists/card this}}{{/each}}
    </div>
  {{else}}
    <div class="card">
      {{#> empty-state iconName="list-checks" title="No lists yet" text="Keep the shopping, the to-dos and everyone’s wishes in one place. Share a list with your household and you’ll see each other’s ticks as they happen."}}
        <button type="button" class="btn btn-primary" data-list-start="shopping">{{icon "shopping-cart" class="size-4"}} Start a shopping list</button>
        <button type="button" class="btn btn-secondary" data-list-start="todo">{{icon "list-todo" class="size-4"}} A to-do list</button>
        <button type="button" class="btn btn-secondary" data-list-start="wish">{{icon "gift" class="size-4"}} A wish list</button>
      {{/empty-state}}
      <p class="border-t border-line px-6 py-3 text-center text-xs text-ink-3">Or just tell me in chat: “add milk and eggs to the shopping list”.</p>
    </div>
  {{/if}}

  {{#if page.archived}}
    <details class="li-archived mt-8" data-lists-archived>
      <summary class="li-archived-h">{{icon "chevron-right" class="size-4 li-archived-chevron"}} Archived <span class="count count-quiet">{{page.archived.length}}</span></summary>
      <ul class="card mt-2 divide-y divide-line" role="list">
        {{#each page.archived}}
          <li class="flex items-center gap-3 px-4 py-3" data-archived-id="{{id}}">
            <span class="list-kind is-quiet" data-kind="{{kind}}">{{icon iconName class="size-4"}}</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium" dir="auto">{{title}}</p>
              <p class="truncate text-xs text-ink-3">{{kindLabel}}{{#if total}}, {{plural total "item"}}{{/if}}{{#if shared}}, shared with {{scope}}{{/if}}</p>
            </div>
            {{#if canManage}}<button type="button" class="btn btn-secondary btn-sm" data-list-restore="{{id}}">{{icon "rotate-ccw" class="size-3.5"}} Restore</button>{{/if}}
          </li>
        {{/each}}
      </ul>
    </details>
  {{/if}}
</div>
