{{!--
  Sticky page header. title, subtitle?, width? (max-w class). Optional block = right-side actions:
  {{#> page-header title="Feed" subtitle="…"}}<button class="btn …">…</button>{{/page-header}}
--}}
<header class="sticky top-0 z-20 border-b border-line bg-canvas/85 backdrop-blur-md">
  <div class="mx-auto flex {{default width 'max-w-5xl'}} items-center gap-3 px-4 py-3 sm:px-6">
    <div class="min-w-0 flex-1">
      <h1 class="truncate text-xl font-semibold tracking-tight">{{title}}</h1>
      {{#if subtitle}}<p class="truncate text-[13px] text-ink-3">{{subtitle}}</p>{{/if}}
    </div>
    {{#if @partial-block}}<div class="flex shrink-0 items-center gap-2">{{> @partial-block}}</div>{{/if}}
    <button type="button" class="shrink-0 rounded-full xl:hidden" data-panel-open="activity" aria-label="Open {{@root.bot.name}}'s activity">
      {{> avatar size="md" activity=@root.shell.agent.activity}}
    </button>
  </div>
</header>
