{{!--
  Discover-style feed card (decision #34). kind: hero (default) | compact | tile (carousel)
  Contract: { id, kind?, topic, title, summary, html, cover?, hue?, source: { name, host }, favicon?, createdAt: ISO,
              readMinutes?, saved?, feedback?: up|down, why?, sources? (cluster size), explore?, written?, url? }
  Cards are stories ("i<itemId>", services/feed.js cardView) or older posts; written=false → the reader asks for Jess's take.
  No cover → tinted topic art (--h). Tap anywhere → reading sheet (feed.js).
--}}
{{#if (eq kind 'compact')}}
  <article class="feed-card feed-compact group" data-post-id="{{id}}" data-url="{{url}}" data-source="{{source.name}}" data-topic="{{topic}}"{{#if saved}} data-saved{{/if}}{{#if written}} data-written{{/if}} style="--h: {{default hue 250}}" tabindex="0" aria-labelledby="t-{{id}}">
    <div class="flex items-center gap-4">
      <div class="min-w-0 flex-1">
        {{> feed/source source=source createdAt=createdAt favicon=favicon sources=sources}}
        <h3 id="t-{{id}}" class="mt-1.5 line-clamp-3 text-[15px] leading-snug font-semibold text-balance">{{title}}</h3>
        {{#if explore}}<p class="mt-1 flex items-center gap-1 text-xs text-accent-text">{{icon "compass" class="size-3"}} {{why}}</p>{{/if}}
      </div>
      <div class="feed-thumb">{{#if cover}}<img src="{{cover}}" alt="" loading="lazy">{{else}}<span class="feed-art" aria-hidden="true"></span>{{/if}}</div>
    </div>
    {{> feed/actions}}
    <template data-post-body>{{{html}}}</template>
  </article>
{{else if (eq kind 'tile')}}
  <article class="feed-card feed-tile group" data-post-id="{{id}}" data-url="{{url}}" data-source="{{source.name}}" data-topic="{{topic}}"{{#if saved}} data-saved{{/if}}{{#if written}} data-written{{/if}} style="--h: {{default hue 250}}" tabindex="0" aria-labelledby="t-{{id}}">
    <div class="feed-cover aspect-[4/5]">{{#if cover}}<img src="{{cover}}" alt="" loading="lazy">{{else}}<span class="feed-art" aria-hidden="true"></span>{{/if}}</div>
    <div class="p-3">
      <h3 id="t-{{id}}" class="line-clamp-2 text-sm leading-snug font-semibold">{{title}}</h3>
      <p class="mt-1 line-clamp-2 text-xs text-ink-3">{{summary}}</p>
    </div>
    <template data-post-body>{{{html}}}</template>
  </article>
{{else}}
  <article class="feed-card feed-hero group" data-post-id="{{id}}" data-url="{{url}}" data-source="{{source.name}}" data-topic="{{topic}}"{{#if saved}} data-saved{{/if}}{{#if written}} data-written{{/if}} style="--h: {{default hue 250}}" tabindex="0" aria-labelledby="t-{{id}}">
    <div class="feed-cover aspect-video">
      {{#if cover}}<img src="{{cover}}" alt="" loading="lazy">{{else}}<span class="feed-art" aria-hidden="true"></span>{{/if}}
    </div>
    <div class="px-4 pt-3.5 pb-2 sm:px-5">
      {{> feed/source source=source createdAt=createdAt readMinutes=readMinutes favicon=favicon sources=sources}}
      <h3 id="t-{{id}}" class="mt-2 text-lg leading-snug font-semibold tracking-tight text-balance sm:text-xl">{{title}}</h3>
      {{#if why}}<p class="mt-1 flex items-center gap-1 text-xs {{#if explore}}text-accent-text{{else}}text-ink-3{{/if}}">{{#if explore}}{{icon "compass" class="size-3"}} {{/if}}{{why}}</p>{{/if}}
      {{#if summary}}<p class="mt-1.5 line-clamp-2 text-[15px] leading-relaxed text-ink-2">{{summary}}</p>{{/if}}
    </div>
    {{> feed/actions}}
    <template data-post-body>{{{html}}}</template>
  </article>
{{/if}}
