{{!-- Progress as a slim bar (replaces the old ring). value 0-100, label (screen-reader name), class (extra classes) --}}
<span class="progress {{class}}" role="progressbar" aria-valuenow="{{default value 0}}" aria-valuemin="0" aria-valuemax="100"
  aria-label="{{default label 'Progress'}}"><span style="width: {{default value 0}}%"></span></span>
