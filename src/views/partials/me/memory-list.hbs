{{!--
  You → Memory: what I remember (the page renders it; GET /api/v1/me/memories?fragment=1 re-renders it after an import
  or a memory.updated frame). Contract: memories = services/memory.js listForUser() [{ id, text, kind, pinned, createdAt,
  scope: private|shared, scopeName, sourceLabel?, sourceHref?, importance: 1-3, date?, recurs?, dateLabel?, useCount,
  lastUsedAt? }]. Client: public/js/memory.js (search, filters, pin, edit, forget with Undo).
--}}
<ul class="space-y-2" role="list" data-memory-list>
  {{#each memories}}
    <li class="card group mem-row" data-memory-id="{{id}}" data-text="{{text}}" data-scope="{{scope}}" data-importance="{{importance}}"
      {{#if dateLabel}}data-dated{{/if}} {{#if pinned}}data-pinned{{/if}}>
      <span class="mt-0.5 text-ink-3" {{#if (eq scope 'shared')}}data-tooltip="Shared with {{scopeName}}"{{else}}data-tooltip="Only you"{{/if}}>{{#if (eq scope 'shared')}}{{icon "users" class="size-4"}}{{else}}{{icon "lock" class="size-4"}}{{/if}}</span>
      <div class="min-w-0 flex-1">
        <p class="text-sm leading-relaxed" dir="auto" data-memory-text>{{text}}</p>
        {{#if (or dateLabel (gt importance 1))}}
          <p class="mt-1.5 flex flex-wrap gap-1.5">
            {{#if dateLabel}}<span class="mem-chip">{{icon "calendar-days" class="size-3"}} {{dateLabel}}</span>{{/if}}
            {{#if (eq importance 3)}}<span class="mem-chip is-accent">Essential</span>{{else if (eq importance 2)}}<span class="mem-chip">Matters to you</span>{{/if}}
          </p>
        {{/if}}
        <p class="mt-1 text-xs text-ink-3">
          {{#if (eq scope 'shared')}}Shared with {{scopeName}}{{else}}Private{{/if}}, saved <time datetime="{{iso createdAt}}" data-relative>{{timeAgo createdAt}}</time>{{#if sourceLabel}}
          in <a href="{{sourceHref}}" class="hover:text-ink-2 hover:underline">{{sourceLabel}}</a>{{/if}}
        </p>
        <p class="text-xs text-ink-3">{{#if useCount}}Used {{plural useCount "time"}}{{#if lastUsedAt}}, most recently <time datetime="{{iso lastUsedAt}}" data-relative>{{timeAgo lastUsedAt}}</time>{{/if}}{{else}}Not used in a reply yet{{/if}}</p>
      </div>
      <div class="mem-actions">
        <button type="button" class="btn btn-ghost btn-icon btn-sm size-7 mem-pin" data-memory-pin aria-pressed="{{#if pinned}}true{{else}}false{{/if}}"
          aria-label="{{#if pinned}}Unpin{{else}}Pin{{/if}}: always keep this in mind" data-tooltip="{{#if pinned}}Pinned: always in mind{{else}}Pin: always keep in mind{{/if}}">{{icon "pin" class="size-3.5"}}</button>
        <button type="button" class="btn btn-ghost btn-icon btn-sm size-7" data-memory-edit aria-label="Edit memory" data-tooltip="Edit">{{icon "pencil" class="size-3.5"}}</button>
        <button type="button" class="btn btn-danger-ghost btn-icon btn-sm size-7" data-memory-forget aria-label="Forget this" data-tooltip="Forget">{{icon "trash-2" class="size-3.5"}}</button>
      </div>
    </li>
  {{else}}
    <li>{{> empty-state iconName="brain" title="Nothing yet" text="As we talk, I’ll save the things worth remembering and show them here, so you’re always in control. You can also import a list." compact=true}}</li>
  {{/each}}
</ul>
