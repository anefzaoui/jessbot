{{!-- Edit a project (or a draft, from its card's "Edit first"). Data: projectOptions { icons: [name], fields: [{ value, label }],
  hues: [n], statuses: [{ value, label }] }. Filled and submitted by public/js/projects.js (POST /api/v1/projects/:id/edit). --}}
<dialog id="project-editor" class="modal max-w-lg" aria-labelledby="project-editor-title">
  <form data-project-form novalidate>
    <div class="modal-header">
      <div class="flex items-center gap-3">
        <span data-project-form-tile>{{> projects/tile icon="folder" hue=250 size="md"}}</span>
        <h2 id="project-editor-title" class="text-base font-semibold">Edit project</h2>
      </div>
      <button type="button" class="btn btn-ghost btn-icon btn-sm" data-modal-close aria-label="Close">{{icon "x" class="size-4"}}</button>
    </div>
    <div class="modal-body space-y-4">
      <div data-field><label class="label" for="pe-name">Name</label>
        <input id="pe-name" name="name" class="input" maxlength="48" autocomplete="off" dir="auto"></div>
      <div data-field><label class="label" for="pe-about">What it’s about</label>
        <textarea id="pe-about" name="about" rows="2" class="textarea text-sm" maxlength="240" placeholder="What it is and what “done” looks like" dir="auto"></textarea></div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div data-field><label class="label" for="pe-field">Field</label>
          <select id="pe-field" name="field" class="select">{{#each projectOptions.fields}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div>
        <div data-field data-project-status-field><label class="label" for="pe-status">Status</label>
          <select id="pe-status" name="status" class="select">{{#each projectOptions.statuses}}<option value="{{value}}">{{label}}</option>{{/each}}</select></div>
      </div>
      <fieldset><legend class="label">Colour</legend>
        <div class="flex flex-wrap gap-2">
          {{#each projectOptions.hues}}<label class="proj-hue" style="--hue: {{this}}"><input type="radio" name="hue" value="{{this}}" class="sr-only"><span aria-hidden="true"></span><span class="sr-only">Colour {{this}}</span></label>{{/each}}
        </div></fieldset>
      <fieldset><legend class="label">Icon</legend>
        <div class="proj-icon-grid">
          {{#each projectOptions.icons}}<label class="proj-icon-opt" title="{{this}}"><input type="radio" name="icon" value="{{this}}" class="sr-only">{{icon this class="size-[18px]"}}<span class="sr-only">{{this}}</span></label>{{/each}}
        </div></fieldset>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-modal-close>Cancel</button><button class="btn btn-primary" data-project-save>Save</button></div>
  </form>
</dialog>
