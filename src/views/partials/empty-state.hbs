{{!--
  Friendly empty state. iconName, title, text, compact?, and an optional block for actions:
  {{#> empty-state iconName="lightbulb" title="…" text="…"}}<a class="btn btn-primary">…</a>{{/empty-state}}
--}}
<div class="flex flex-col items-center text-center {{#if compact}}px-4 py-8{{else}}px-6 py-16{{/if}}">
  <div class="relative">
    <span class="grid {{#if compact}}size-11{{else}}size-14{{/if}} place-items-center rounded-2xl border border-line bg-surface text-ink-3" style="box-shadow: var(--jb-shadow)">
      {{#if compact}}{{icon iconName class="size-5"}}{{else}}{{icon iconName class="size-6"}}{{/if}}
    </span>
  </div>
  <h3 class="mt-4 {{#if compact}}text-sm{{else}}text-base{{/if}} font-semibold">{{title}}</h3>
  <p class="mt-1.5 max-w-xs {{#if compact}}text-xs{{else}}text-sm{{/if}} leading-relaxed text-pretty text-ink-3">{{text}}</p>
  {{#if @partial-block}}<div class="mt-5 flex flex-wrap justify-center gap-2">{{> @partial-block}}</div>{{/if}}
</div>
