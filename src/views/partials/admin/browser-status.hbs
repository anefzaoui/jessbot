{{!--
  Browser status card body (Admin → Browser, setup's Internet step). Re-rendered by GET /admin/browser/status while it changes.
  status: { engine: { id, label, summary }, engines: [{ id, label, summary }], installed, source: bundled|system, version, tier?,
            platform, binaryPath, installing, installError, progress: { downloadedMB, totalMB, pct, unpacking }?,
            unsupported?, running, openPages, queued, lastUsedAt, blockedCount, license: { present, masked?, source? },
            adblock?: { ready, error, building, blocked }, searxng?: { url, healthy, lastError, downUntil } }
--}}
<div class="flex flex-wrap items-start gap-4" data-browser-state="{{#if status.installing}}installing{{else if status.installed}}ready{{else}}missing{{/if}}">
  <span class="grid size-12 shrink-0 place-items-center rounded-2xl {{#if status.installed}}bg-ok-soft text-ok{{else if status.installing}}bg-accent-soft text-accent-text{{else}}bg-surface-2 text-ink-3{{/if}}">
    {{#if status.installing}}<span class="spinner size-5"></span>{{else}}{{icon "globe" class="size-6"}}{{/if}}
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-base font-semibold">{{status.engine.label}}</h2>
      {{#if status.installing}}<span class="badge badge-accent">Installing</span>
      {{else if status.installed}}<span class="badge badge-ok">Ready</span>
      {{else}}<span class="badge badge-warn">Not installed</span>{{/if}}
      {{#if (and status.installed status.tier)}}<span class="badge badge-neutral">{{#if (eq status.tier 'pro')}}Licensed build{{else}}Free build{{/if}}</span>{{/if}}
      {{#if (and status.installed (eq status.source 'system'))}}<span class="badge badge-neutral">Installed on this computer</span>{{/if}}
    </div>
    <p class="mt-0.5 text-[13px] text-ink-2">
      {{#if status.installing}}
        {{#if status.progress.unpacking}}Unpacking the browser…{{else}}Downloading the browser. You can leave this page; it keeps going.{{/if}}
      {{else if status.installed}}
        {{@root.bot.name}} reads the web through this browser, running on this computer. It starts when needed and sleeps when idle.
      {{else}}
        {{@root.bot.name}} can’t search or read the web until the browser is installed ({{#if (eq status.engine.id 'cloakbrowser')}}about 500 MB, downloaded once into <code class="font-mono text-xs">tools/cloakbrowser</code>{{else}}about 200 MB, downloaded once into <code class="font-mono text-xs">tools/ms-playwright</code>{{/if}}).
      {{/if}}
    </p>

    {{#if status.installing}}
      <div class="mt-3 max-w-md">
        <div class="h-2 overflow-hidden rounded-full bg-surface-3" role="progressbar" aria-label="Download progress"
          {{#if status.progress.pct}}aria-valuenow="{{status.progress.pct}}" aria-valuemin="0" aria-valuemax="100"{{/if}}>
          <div class="h-full rounded-full bg-accent transition-[width] duration-500 {{#unless status.progress.pct}}w-1/3 animate-pulse{{/unless}}" {{#if status.progress.pct}}style="width: {{status.progress.pct}}%"{{/if}}></div>
        </div>
        <p class="tabular mt-1.5 text-xs text-ink-3">
          {{#if status.progress.totalMB}}{{status.progress.downloadedMB}} / {{status.progress.totalMB}} MB · {{status.progress.pct}}%{{else}}{{default status.progress.downloadedMB 0}} MB downloaded{{/if}}
        </p>
      </div>
    {{/if}}

    {{#if status.installError}}
      <p class="mt-3 flex items-start gap-2 rounded-lg border border-bad/30 bg-bad-soft px-3 py-2 text-[13px] text-ink" role="alert">
        <span class="mt-0.5 text-bad">{{icon "triangle-alert" class="size-4"}}</span> Install failed: {{status.installError}}
      </p>
    {{/if}}
    {{#if status.unsupported}}
      <p class="mt-3 text-[13px] text-bad">{{status.unsupported}}</p>
    {{/if}}

    {{#if status.installed}}
      <dl class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 text-[13px] @xl:grid-cols-4">
        <div><dt class="text-xs text-ink-3">Version</dt><dd class="tabular font-medium" title="{{status.version}}">Chromium {{status.major}}</dd></div>
        <div><dt class="text-xs text-ink-3">Right now</dt><dd class="font-medium">
          {{#if status.running}}{{#if status.openPages}}{{plural status.openPages "page"}} open{{#if status.queued}} · {{status.queued}} waiting{{/if}}{{else}}Awake, idle{{/if}}{{else}}Asleep{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-3">Last used</dt><dd class="font-medium">{{#if status.lastUsedAt}}<time datetime="{{status.lastUsedAt}}" data-relative>{{timeAgo status.lastUsedAt}}</time>{{else}}Not yet{{/if}}</dd></div>
        <div><dt class="text-xs text-ink-3">Local network</dt><dd class="font-medium">{{#if @root.settings.allowPrivate}}Allowed{{else}}Blocked{{#if status.blockedCount}} · {{status.blockedCount}} stopped{{/if}}{{/if}}</dd></div>
      </dl>
      {{!-- Ad blocking and SearXNG, when switched on (Phase 25, #195). --}}
      {{#if (or status.adblock status.searxng)}}
        <ul class="mt-4 space-y-1.5 border-t border-line pt-3 text-[13px]" role="list">
          {{#if status.adblock}}<li class="browser-line" data-browser-adblock data-state="{{#if status.adblock.error}}error{{else if status.adblock.ready}}ready{{else}}building{{/if}}">
            {{icon "shield-check" class="size-4"}} <span class="font-medium">Ad blocking</span>
            <span class="text-ink-2">{{#if status.adblock.error}}the filter lists didn’t download: {{status.adblock.error}}{{else if status.adblock.ready}}on{{#if status.adblock.blocked}}, {{num status.adblock.blocked}} ads and trackers stopped since the server started{{/if}}{{else}}getting the filter lists ready (pages load unblocked meanwhile){{/if}}</span></li>{{/if}}
          {{#if status.searxng}}<li class="browser-line" data-browser-searxng data-state="{{#if status.searxng.healthy}}ready{{else}}error{{/if}}">
            {{icon "search" class="size-4"}} <span class="font-medium">SearXNG</span> <span class="truncate font-mono text-xs text-ink-3" dir="ltr">{{status.searxng.url}}</span>
            <span class="text-ink-2">{{#if status.searxng.healthy}}answering, used first{{else}}not answering{{#if status.searxng.lastError}} ({{status.searxng.lastError}}){{/if}}{{#if status.searxng.downUntil}}; the other engines are used until <time datetime="{{status.searxng.downUntil}}">{{time status.searxng.downUntil}}</time>{{/if}}{{/if}}</span></li>{{/if}}
        </ul>
      {{/if}}
    {{/if}}
  </div>

  <div class="flex shrink-0 flex-wrap gap-2">
    {{#unless status.installing}}
      {{#if status.installed}}
        {{#if status.running}}
          <form method="post" action="/admin/browser/restart" data-ajax data-stay data-success="Browser closed. It restarts on the next request." data-browser-refresh>
            <button class="btn btn-secondary btn-sm">{{icon "rotate-ccw" class="size-4"}} Restart</button>
          </form>
        {{/if}}
      {{else}}
        <form method="post" action="{{default @root.installAction '/admin/browser/install'}}" data-ajax data-stay data-busy="Starting…" data-browser-refresh>
          <button class="btn btn-primary">{{icon "download" class="size-4"}} Install browser</button>
        </form>
      {{/if}}
    {{/unless}}
  </div>
</div>
