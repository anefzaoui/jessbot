{
  "name": "jessbot",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Self-hosted, portable personal AI agent for a household or team.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "assets": "node scripts/build-assets.js",
    "css": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/css/app.css --watch",
    "build": "npm run assets && npm run css",
    "dev": "node scripts/dev.js",
    "start": "node server.js",
    "check": "node --check server.js",
    "lint": "node scripts/lint.js",
    "db:status": "node scripts/db-status.js",
    "db:backup": "node scripts/db-status.js --backup",
    "browser:install": "node scripts/browser-install.js",
    "searxng:install": "node scripts/searxng.js install",
    "searxng:start": "node scripts/searxng.js start",
    "links:check": "node scripts/links-check.js",
    "ui:check": "node scripts/ui-check.js",
    "ui:flows": "node scripts/ui-flows.js",
    "test:e2e": "node scripts/e2e-setup.js",
    "assets:images": "node scripts/build-images.js",
    "brand": "node scripts/build-brand.js",
    "test:chat": "node scripts/e2e-chat.js",
    "eval:agent": "node scripts/agent-eval.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "restore": "node scripts/restore.js",
    "reset-link": "node scripts/reset-link.js",
    "doctor": "node scripts/doctor.js",
    "secrets:rotate": "node scripts/rotate-secret.js"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@duckduckgo/autoconsent": "18.9.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-serif": "5.3.0",
    "@fontsource/stix-two-math": "5.3.0",
    "@formulajs/formulajs": "4.6.1",
    "@ghostery/adblocker": "2.20.3",
    "@mozilla/readability": "0.6.0",
    "@napi-rs/canvas": "1.1.1",
    "croner": "11.0.1",
    "cronstrue": "3.43.0",
    "date-holidays": "3.39.2",
    "diff": "9.0.0",
    "docx": "9.16.0",
    "docxtemplater": "3.71.1",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "express-rate-limit": "8.7.3",
    "fast-formula-parser": "1.0.19",
    "feedscout": "2.3.0",
    "feedsmith": "3.1.0",
    "file-type": "22.3.0",
    "gpt-tokenizer": "^4.1.2",
    "handlebars": "^4.7.10",
    "highlight.js": "11.12.0",
    "ical.js": "2.2.1",
    "image-size": "2.1.0",
    "imapflow": "2.12.1",
    "linkedom": "0.18.15",
    "mailparser": "3.14.5",
    "mammoth": "1.13.0",
    "markdown-it": "^15.0.3",
    "multer": "2.5.0",
    "nodemailer": "10.6.0",
    "officeparser": "8.9.0",
    "openai": "^7.61.0",
    "otpauth": "9.6.0",
    "patchright-core": "1.64.3",
    "pdfjs-dist": "6.5.438",
    "pizzip": "3.3.0",
    "playwright-core": "1.64.1",
    "pptxgenjs": "4.0.1",
    "sanitize-html": "2.18.2",
    "tar": "7.5.23",
    "temml": "0.14.0",
    "tldts": "7.5.5",
    "tsdav": "2.5.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "8.12.4",
    "unpdf": "2.2.1",
    "uqr": "0.1.3",
    "web-push": "4.0.0",
    "ws": "^8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "^4.3.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "optionalDependencies": {
    "cloakbrowser": "0.7.2"
  },
  "overrides": {
    "image-size": "2.1.0",
    "uuid": "11.1.1"
  }
}
